        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "INVALID_INPUT",
                "INTERNAL_ERROR",
                "UNSUPPORTED_VERSION",
                "MISSING_RELEASE",
                "SCOPE_MISMATCH",
                "UNAVAILABLE_ANALYSIS",
                "INVALID_PACK",
                "CANCELLED",
                "PAYLOAD_TOO_LARGE"
              ]
            },
            "message": { "type": "string", "minLength": 1, "maxLength": 10000 }
          },
          "required": ["code", "message"],
          "additionalProperties": false
        },
        "warnings": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 10000 }
        },
        "releases": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "packId": {
                "type": "string",
                "maxLength": 160,
